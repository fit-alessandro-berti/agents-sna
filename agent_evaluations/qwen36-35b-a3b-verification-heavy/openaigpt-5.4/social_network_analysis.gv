  "formal_semantics_checker" -> "benchmark_answer_judge" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,4 std=1,8</B></FONT></TD></TR></TABLE>>, color="#c0cc7b", fontcolor="#c0cc7b", penwidth="1.29"];
