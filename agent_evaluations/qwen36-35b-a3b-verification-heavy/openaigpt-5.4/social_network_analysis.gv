  "bias_and_impact_auditor" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,8 std=1,2</B></FONT></TD></TR></TABLE>>, color="#d7d481", fontcolor="#d7d481", penwidth="1.16"];
