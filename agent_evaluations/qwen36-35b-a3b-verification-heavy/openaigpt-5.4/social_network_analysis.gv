digraph social_network_analysis {
  graph [
    rankdir="TB",
    bgcolor="transparent",
    margin="0.03",
    pad="0.02",
    nodesep="0.22",
    ranksep="0.32",
    splines="polyline",
    concentrate="true",
    outputorder="edgesfirst",
    ordering="out"
  ];
  node [
    shape="box",
    style="rounded,filled",
    fontname="Helvetica-Bold",
    fontsize="9",
    margin="0.045,0.035",
    penwidth="0.8",
    color="#666666"
  ];
  edge [
    fontname="Helvetica-Bold",
    fontsize="6.8",
    arrowsize="0.55",
    fontcolor="#333333"
  ];

  "START" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>START</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,5 std=0,7</B></FONT></TD></TR></TABLE>>, fillcolor="#c6deb6"];
  "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>COMPLETE</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,3 std=1,7</B></FONT></TD></TR></TABLE>>, fillcolor="#f7edc3"];
  "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>domain<BR/>reasoner</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=54</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,1 std=1,7</B></FONT></TD></TR></TABLE>>, fillcolor="#fcefc4"];
  "artifact_parser" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>artifact<BR/>parser</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=26</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,2 std=1,5</B></FONT></TD></TR></TABLE>>, fillcolor="#e4e7be"];
  "benchmark_answer_judge" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>benchmark<BR/>answer<BR/>judge</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=26</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,1 std=2,1</B></FONT></TD></TR></TABLE>>, fillcolor="#fdefc4"];
  "formal_semantics_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>formal<BR/>semantics<BR/>checker</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=12</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,4 std=2,2</B></FONT></TD></TR></TABLE>>, fillcolor="#f5ecc2"];
  "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>counterexample<BR/>hunter</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=9</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,6 std=2,8</B></FONT></TD></TR></TABLE>>, fillcolor="#f2ecc2"];
  "data_consistency_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>data<BR/>consistency<BR/>auditor</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=8</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,5 std=1,6</B></FONT></TD></TR></TABLE>>, fillcolor="#f4ecc2"];
  "bias_and_impact_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>bias<BR/>and<BR/>impact<BR/>auditor</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=6</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,8 std=1,8</B></FONT></TD></TR></TABLE>>, fillcolor="#eceac0"];

