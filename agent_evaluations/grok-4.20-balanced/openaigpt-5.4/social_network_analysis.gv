digraph social_network_analysis {
  graph [
    rankdir="TB",
    bgcolor="transparent",
    margin="0.03",
    pad="0.02",
    nodesep="0.22",
    ranksep="0.32",
    splines="polyline",
    concentrate="true",
    outputorder="edgesfirst",
    ordering="out"
  ];
  node [
    shape="box",
    style="rounded,filled",
    fontname="Helvetica-Bold",
    fontsize="9",
    margin="0.045,0.035",
    penwidth="0.8",
    color="#666666"
  ];
  edge [
    fontname="Helvetica-Bold",
    fontsize="6.8",
    arrowsize="0.55",
    fontcolor="#333333"
  ];

  "process_modeler" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>process<BR/>modeler</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=58</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=4,1 std=2,0</B></FONT></TD></TR></TABLE>>, fillcolor="#fbe0bc"];
  "START" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>START</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=8,1 std=0,8</B></FONT></TD></TR></TABLE>>, fillcolor="#b8d9b2"];
  "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>COMPLETE</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,3 std=2,2</B></FONT></TD></TR></TABLE>>, fillcolor="#f7edc3"];
  "conformance_anomaly_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>conformance<BR/>anomaly<BR/>checker</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=52</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=3,3 std=2,0</B></FONT></TD></TR></TABLE>>, fillcolor="#f8d2b4"];
  "hypothesis_generator" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>hypothesis<BR/>generator</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=46</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,1 std=1,8</B></FONT></TD></TR></TABLE>>, fillcolor="#fceec4"];
  "fairness_and_ethics_reviewer" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>fairness<BR/>and<BR/>ethics<BR/>reviewer</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=34</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=3,7 std=2,3</B></FONT></TD></TR></TABLE>>, fillcolor="#fad9b8"];
  "event_log_interpreter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>event<BR/>log<BR/>interpreter</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=32</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,2 std=2,4</B></FONT></TD></TR></TABLE>>, fillcolor="#fbeec4"];
  "optimization_consultant" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>optimization<BR/>consultant</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=32</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=3,7 std=2,2</B></FONT></TD></TR></TABLE>>, fillcolor="#fad8b8"];
