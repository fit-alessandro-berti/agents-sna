digraph social_network_analysis {
  graph [
    rankdir="TB",
    bgcolor="transparent",
    margin="0.03",
    pad="0.02",
    nodesep="0.22",
    ranksep="0.32",
    splines="polyline",
    concentrate="true",
    outputorder="edgesfirst",
    ordering="out"
  ];
  node [
    shape="box",
    style="rounded,filled",
    fontname="Helvetica-Bold",
    fontsize="9",
    margin="0.045,0.035",
    penwidth="0.8",
    color="#666666"
  ];
  edge [
    fontname="Helvetica-Bold",
    fontsize="6.8",
    arrowsize="0.55",
    fontcolor="#333333"
  ];

  "START" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>START</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,4 std=0,7</B></FONT></TD></TR></TABLE>>, fillcolor="#c8deb7"];
  "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>COMPLETE</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,5 std=2,0</B></FONT></TD></TR></TABLE>>, fillcolor="#f4ecc2"];
  "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>domain<BR/>reasoner</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,2 std=1,5</B></FONT></TD></TR></TABLE>>, fillcolor="#faeec4"];
  "artifact_parser" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>artifact<BR/>parser</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=22</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,5 std=1,7</B></FONT></TD></TR></TABLE>>, fillcolor="#dce4bc"];
  "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>counterexample<BR/>hunter</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=16</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,5 std=2,3</B></FONT></TD></TR></TABLE>>, fillcolor="#dce5bc"];
  "data_consistency_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>data<BR/>consistency<BR/>auditor</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=10</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=4,8 std=1,4</B></FONT></TD></TR></TABLE>>, fillcolor="#feedc4"];
  "formal_semantics_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>formal<BR/>semantics<BR/>checker</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=10</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=3,5 std=1,8</B></FONT></TD></TR></TABLE>>, fillcolor="#f8d5b6"];
  "bias_and_impact_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>bias<BR/>and<BR/>impact<BR/>auditor</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,4 std=1,4</B></FONT></TD></TR></TABLE>>, fillcolor="#dfe6bd"];
  "benchmark_answer_judge" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>benchmark<BR/>answer<BR/>judge</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=4</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,0 std=1,0</B></FONT></TD></TR></TABLE>>, fillcolor="#fef0c5"];

  "START" -> "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=31</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,5 std=1,3</B></FONT></TD></TR></TABLE>>, color="#e7d985", fontcolor="#e7d985", penwidth="4.50"];
  "domain_reasoner" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=25</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,5 std=2,2</B></FONT></TD></TR></TABLE>>, color="#e5d885", fontcolor="#e5d885", penwidth="3.80"];
  "START" -> "artifact_parser" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=22</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,5 std=1,7</B></FONT></TD></TR></TABLE>>, color="#b9ca79", fontcolor="#b9ca79", penwidth="3.45"];
  "artifact_parser" -> "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=19</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=4,7 std=1,4</B></FONT></TD></TR></TABLE>>, color="#fbd585", fontcolor="#fbd585", penwidth="3.11"];
  "domain_reasoner" -> "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=12</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,7 std=2,4</B></FONT></TD></TR></TABLE>>, color="#afc777", fontcolor="#afc777", penwidth="2.29"];
  "domain_reasoner" -> "formal_semantics_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=10</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=3,5 std=1,8</B></FONT></TD></TR></TABLE>>, color="#f2ab6d", fontcolor="#f2ab6d", penwidth="2.06"];
  "data_consistency_auditor" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=8</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,1 std=1,3</B></FONT></TD></TR></TABLE>>, color="#f9df8a", fontcolor="#f9df8a", penwidth="1.83"];
  "domain_reasoner" -> "data_consistency_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=8</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=4,6 std=1,3</B></FONT></TD></TR></TABLE>>, color="#fbd182", fontcolor="#fbd182", penwidth="1.83"];
  "counterexample_hunter" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,1 std=2,3</B></FONT></TD></TR></TABLE>>, color="#ccd07e", fontcolor="#ccd07e", penwidth="1.71"];
  "formal_semantics_checker" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=4,3 std=1,9</B></FONT></TD></TR></TABLE>>, color="#f8c67c", fontcolor="#f8c67c", penwidth="1.71"];
  "counterexample_hunter" -> "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=6</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,5 std=2,0</B></FONT></TD></TR></TABLE>>, color="#e6d985", fontcolor="#e6d985", penwidth="1.60"];
  "bias_and_impact_auditor" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=4</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,8 std=0,7</B></FONT></TD></TR></TABLE>>, color="#d7d481", fontcolor="#d7d481", penwidth="1.36"];
  "benchmark_answer_judge" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=4</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,4 std=1,9</B></FONT></TD></TR></TABLE>>, color="#eddb87", fontcolor="#eddb87", penwidth="1.36"];
  "START" -> "bias_and_impact_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,7 std=0,6</B></FONT></TD></TR></TABLE>>, color="#b0c877", fontcolor="#b0c877", penwidth="1.25"];
  "counterexample_hunter" -> "benchmark_answer_judge" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,3 std=1,0</B></FONT></TD></TR></TABLE>>, color="#efdb87", fontcolor="#efdb87", penwidth="1.25"];
  "artifact_parser" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,9 std=0,1</B></FONT></TD></TR></TABLE>>, color="#7ab669", fontcolor="#7ab669", penwidth="1.13"];
  "bias_and_impact_auditor" -> "data_consistency_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,0 std=1,1</B></FONT></TD></TR></TABLE>>, color="#d0d27f", fontcolor="#d0d27f", penwidth="1.13"];
  "domain_reasoner" -> "bias_and_impact_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=4,5 std=0,2</B></FONT></TD></TR></TABLE>>, color="#face81", fontcolor="#face81", penwidth="1.13"];
  "formal_semantics_checker" -> "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=4,3 std=0,9</B></FONT></TD></TR></TABLE>>, color="#f9c97e", fontcolor="#f9c97e", penwidth="1.13"];
  "START" -> "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,9 std=0,0</B></FONT></TD></TR></TABLE>>, color="#4ca85d", fontcolor="#4ca85d", penwidth="1.02"];
  "artifact_parser" -> "bias_and_impact_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,4 std=0,0</B></FONT></TD></TR></TABLE>>, color="#63af63", fontcolor="#63af63", penwidth="1.02"];
  "formal_semantics_checker" -> "bias_and_impact_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,1 std=0,0</B></FONT></TD></TR></TABLE>>, color="#9ec272", fontcolor="#9ec272", penwidth="1.02"];
  "data_consistency_auditor" -> "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,4 std=0,0</B></FONT></TD></TR></TABLE>>, color="#ecda86", fontcolor="#ecda86", penwidth="1.02"];
  "bias_and_impact_auditor" -> "benchmark_answer_judge" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=4,1 std=0,0</B></FONT></TD></TR></TABLE>>, color="#f7c079", fontcolor="#f7c079", penwidth="1.02"];
  "data_consistency_auditor" -> "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=2,8 std=0,0</B></FONT></TD></TR></TABLE>>, color="#ed935f", fontcolor="#ed935f", penwidth="1.02"];
}
