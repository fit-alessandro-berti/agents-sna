digraph social_network_analysis {
  graph [
    rankdir="TB",
    bgcolor="transparent",
    margin="0.03",
    pad="0.02",
    nodesep="0.22",
    ranksep="0.32",
    splines="polyline",
    concentrate="true",
    outputorder="edgesfirst",
    ordering="out"
  ];
  node [
    shape="box",
    style="rounded,filled",
    fontname="Helvetica-Bold",
    fontsize="9",
    margin="0.045,0.035",
    penwidth="0.8",
    color="#666666"
  ];
  edge [
    fontname="Helvetica-Bold",
    fontsize="6.8",
    arrowsize="0.55",
    fontcolor="#333333"
  ];

  "formal_semantics_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>formal<BR/>semantics<BR/>checker</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=63</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=4,3 std=2,1</B></FONT></TD></TR></TABLE>>, fillcolor="#fce3be"];
  "artifact_parser" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>artifact<BR/>parser</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=59</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,9 std=2,1</B></FONT></TD></TR></TABLE>>, fillcolor="#d4e2ba"];
  "benchmark_answer_judge" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>benchmark<BR/>answer<BR/>judge</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=58</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,7 std=2,3</B></FONT></TD></TR></TABLE>>, fillcolor="#efeac1"];
  "START" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>START</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,8 std=0,9</B></FONT></TD></TR></TABLE>>, fillcolor="#bedcb4"];
  "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>COMPLETE</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,8 std=2,1</B></FONT></TD></TR></TABLE>>, fillcolor="#eceac0"];
  "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>domain<BR/>reasoner</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=50</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,3 std=1,7</B></FONT></TD></TR></TABLE>>, fillcolor="#f8eec4"];
  "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>counterexample<BR/>hunter</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=49</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,7 std=2,5</B></FONT></TD></TR></TABLE>>, fillcolor="#f0eac1"];
