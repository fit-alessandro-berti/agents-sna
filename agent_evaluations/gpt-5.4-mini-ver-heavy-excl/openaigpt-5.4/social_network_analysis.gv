digraph social_network_analysis {
  graph [
    rankdir="TB",
    bgcolor="transparent",
    margin="0.03",
    pad="0.02",
    nodesep="0.22",
    ranksep="0.32",
    splines="polyline",
    concentrate="true",
    outputorder="edgesfirst",
    ordering="out"
  ];
  node [
    shape="box",
    style="rounded,filled",
    fontname="Helvetica-Bold",
    fontsize="9",
    margin="0.045,0.035",
    penwidth="0.8",
    color="#666666"
  ];
  edge [
    fontname="Helvetica-Bold",
    fontsize="6.8",
    arrowsize="0.55",
    fontcolor="#333333"
  ];

  "START" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>START</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,6 std=0,7</B></FONT></TD></TR></TABLE>>, fillcolor="#c2dcb6"];
  "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>COMPLETE</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,0 std=1,7</B></FONT></TD></TR></TABLE>>, fillcolor="#d2e1ba"];
  "artifact_parser" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>artifact<BR/>parser</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=55</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,5 std=2,0</B></FONT></TD></TR></TABLE>>, fillcolor="#dce4bc"];
  "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>domain<BR/>reasoner</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=34</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,8 std=1,7</B></FONT></TD></TR></TABLE>>, fillcolor="#d5e2ba"];
  "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>counterexample<BR/>hunter</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=13</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,8 std=1,1</B></FONT></TD></TR></TABLE>>, fillcolor="#bedbb4"];
  "formal_semantics_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>formal<BR/>semantics<BR/>checker</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=10</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,6 std=1,1</B></FONT></TD></TR></TABLE>>, fillcolor="#c2dcb6"];
  "bias_and_impact_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>bias<BR/>and<BR/>impact<BR/>auditor</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,8 std=0,7</B></FONT></TD></TR></TABLE>>, fillcolor="#bedbb4"];
  "benchmark_answer_judge" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>benchmark<BR/>answer<BR/>judge</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,2 std=0,1</B></FONT></TD></TR></TABLE>>, fillcolor="#cee0b8"];
  "data_consistency_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>data<BR/>consistency<BR/>auditor</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,8 std=0,0</B></FONT></TD></TR></TABLE>>, fillcolor="#eceac0"];

  "START" -> "artifact_parser" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=55</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,5 std=2,0</B></FONT></TD></TR></TABLE>>, color="#b8ca79", fontcolor="#b8ca79", penwidth="4.50"];
  "artifact_parser" -> "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=30</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,9 std=1,7</B></FONT></TD></TR></TABLE>>, color="#a6c474", fontcolor="#a6c474", penwidth="2.86"];
  "domain_reasoner" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=21</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,2 std=1,8</B></FONT></TD></TR></TABLE>>, color="#9ac171", fontcolor="#9ac171", penwidth="2.27"];
  "artifact_parser" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=14</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,5 std=1,8</B></FONT></TD></TR></TABLE>>, color="#bbcb7a", fontcolor="#bbcb7a", penwidth="1.82"];
  "counterexample_hunter" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=10</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,2 std=1,5</B></FONT></TD></TR></TABLE>>, color="#98c071", fontcolor="#98c071", penwidth="1.55"];
  "domain_reasoner" -> "formal_semantics_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=9</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,6 std=1,1</B></FONT></TD></TR></TABLE>>, color="#86ba6c", fontcolor="#86ba6c", penwidth="1.49"];
  "artifact_parser" -> "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=8</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,3 std=1,2</B></FONT></TD></TR></TABLE>>, color="#95bf70", fontcolor="#95bf70", penwidth="1.42"];
  "formal_semantics_checker" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,7 std=1,6</B></FONT></TD></TR></TABLE>>, color="#b1c877", fontcolor="#b1c877", penwidth="1.36"];
  "domain_reasoner" -> "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=4</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,6 std=0,3</B></FONT></TD></TR></TABLE>>, color="#5cad61", fontcolor="#5cad61", penwidth="1.16"];
  "counterexample_hunter" -> "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,7 std=1,4</B></FONT></TD></TR></TABLE>>, color="#b0c877", fontcolor="#b0c877", penwidth="1.10"];
  "bias_and_impact_auditor" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,3 std=0,3</B></FONT></TD></TR></TABLE>>, color="#68b064", fontcolor="#68b064", penwidth="1.03"];
  "artifact_parser" -> "bias_and_impact_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,6 std=0,8</B></FONT></TD></TR></TABLE>>, color="#87bb6c", fontcolor="#87bb6c", penwidth="1.03"];
  "formal_semantics_checker" -> "benchmark_answer_judge" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,2 std=0,1</B></FONT></TD></TR></TABLE>>, color="#9cc172", fontcolor="#9cc172", penwidth="1.03"];
  "benchmark_answer_judge" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,0 std=0,0</B></FONT></TD></TR></TABLE>>, color="#a3c373", fontcolor="#a3c373", penwidth="1.03"];
  "formal_semantics_checker" -> "counterexample_hunter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,9 std=0,0</B></FONT></TD></TR></TABLE>>, color="#4ca85d", fontcolor="#4ca85d", penwidth="0.97"];
  "START" -> "bias_and_impact_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,3 std=0,0</B></FONT></TD></TR></TABLE>>, color="#68b064", fontcolor="#68b064", penwidth="0.97"];
  "bias_and_impact_auditor" -> "formal_semantics_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,8 std=0,0</B></FONT></TD></TR></TABLE>>, color="#7eb86a", fontcolor="#7eb86a", penwidth="0.97"];
  "data_consistency_auditor" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,7 std=0,0</B></FONT></TD></TR></TABLE>>, color="#b0c877", fontcolor="#b0c877", penwidth="0.97"];
  "artifact_parser" -> "data_consistency_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,8 std=0,0</B></FONT></TD></TR></TABLE>>, color="#dad482", fontcolor="#dad482", penwidth="0.97"];
  "START" -> "domain_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=4,2 std=0,0</B></FONT></TD></TR></TABLE>>, color="#f8c47b", fontcolor="#f8c47b", penwidth="0.97"];
}
