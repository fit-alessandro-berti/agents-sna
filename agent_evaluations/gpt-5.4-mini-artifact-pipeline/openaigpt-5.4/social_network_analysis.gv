digraph social_network_analysis {
  graph [
    rankdir="TB",
    bgcolor="transparent",
    margin="0.03",
    pad="0.02",
    nodesep="0.22",
    ranksep="0.32",
    splines="polyline",
    concentrate="true",
    outputorder="edgesfirst",
    ordering="out"
  ];
  node [
    shape="box",
    style="rounded,filled",
    fontname="Helvetica-Bold",
    fontsize="9",
    margin="0.045,0.035",
    penwidth="0.8",
    color="#666666"
  ];
  edge [
    fontname="Helvetica-Bold",
    fontsize="6.8",
    arrowsize="0.55",
    fontcolor="#333333"
  ];

  "START" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>START</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,4 std=1,6</B></FONT></TD></TR></TABLE>>, fillcolor="#c8deb7"];
  "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>COMPLETE</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,7 std=2,1</B></FONT></TD></TR></TABLE>>, fillcolor="#d7e3bb"];
  "answer_precision_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>answer<BR/>precision<BR/>auditor</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=56</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,5 std=1,7</B></FONT></TD></TR></TABLE>>, fillcolor="#c5deb6"];
  "schema_and_artifact_mapper" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>schema<BR/>and<BR/>artifact<BR/>mapper</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=41</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,6 std=1,5</B></FONT></TD></TR></TABLE>>, fillcolor="#dae4bc"];
  "control_flow_semantics_expert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>control<BR/>flow<BR/>semantics<BR/>expert</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,2 std=2,0</B></FONT></TD></TR></TABLE>>, fillcolor="#cee0b8"];
  "risk_fairness_and_compliance_reviewer" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>risk<BR/>fairness<BR/>and<BR/>compliance<BR/>reviewer</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=5</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,4 std=1,2</B></FONT></TD></TR></TABLE>>, fillcolor="#c8deb7"];
  "trace_and_variant_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>trace<BR/>and<BR/>variant<BR/>reasoner</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=5,3 std=2,7</B></FONT></TD></TR></TABLE>>, fillcolor="#f6edc3"];

  "answer_precision_auditor" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=55</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,8 std=2,1</B></FONT></TD></TR></TABLE>>, color="#abc675", fontcolor="#abc675", penwidth="4.50"];
  "START" -> "schema_and_artifact_mapper" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=41</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,6 std=1,5</B></FONT></TD></TR></TABLE>>, color="#b6c978", fontcolor="#b6c978", penwidth="3.58"];
  "schema_and_artifact_mapper" -> "answer_precision_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=37</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,7 std=1,6</B></FONT></TD></TR></TABLE>>, color="#82b96b", fontcolor="#82b96b", penwidth="3.32"];
  "control_flow_semantics_expert" -> "answer_precision_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,9 std=0,7</B></FONT></TD></TR></TABLE>>, color="#7ab669", fontcolor="#7ab669", penwidth="1.36"];
  "risk_fairness_and_compliance_reviewer" -> "answer_precision_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=5</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,9 std=0,4</B></FONT></TD></TR></TABLE>>, color="#78b668", fontcolor="#78b668", penwidth="1.23"];
  "START" -> "risk_fairness_and_compliance_reviewer" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=5</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,4 std=1,2</B></FONT></TD></TR></TABLE>>, color="#91bd6f", fontcolor="#91bd6f", penwidth="1.23"];
  "START" -> "answer_precision_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=5</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,8 std=2,5</B></FONT></TD></TR></TABLE>>, color="#dad482", fontcolor="#dad482", penwidth="1.23"];
  "START" -> "control_flow_semantics_expert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,6 std=0,2</B></FONT></TD></TR></TABLE>>, color="#5aac61", fontcolor="#5aac61", penwidth="1.10"];
  "schema_and_artifact_mapper" -> "control_flow_semantics_expert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,4 std=1,9</B></FONT></TD></TR></TABLE>>, color="#ecda86", fontcolor="#ecda86", penwidth="1.10"];
  "trace_and_variant_reasoner" -> "answer_precision_auditor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,8 std=2,7</B></FONT></TD></TR></TABLE>>, color="#d7d481", fontcolor="#d7d481", penwidth="1.03"];
  "START" -> "trace_and_variant_reasoner" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,3 std=2,7</B></FONT></TD></TR></TABLE>>, color="#eedb87", fontcolor="#eedb87", penwidth="1.03"];
  "answer_precision_auditor" -> "control_flow_semantics_expert" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,1 std=0,0</B></FONT></TD></TR></TABLE>>, color="#71b366", fontcolor="#71b366", penwidth="0.97"];
  "schema_and_artifact_mapper" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,0 std=0,0</B></FONT></TD></TR></TABLE>>, color="#d0d27f", fontcolor="#d0d27f", penwidth="0.97"];
  "START" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=2,6 std=0,0</B></FONT></TD></TR></TABLE>>, color="#eb8c5b", fontcolor="#eb8c5b", penwidth="0.97"];
}
