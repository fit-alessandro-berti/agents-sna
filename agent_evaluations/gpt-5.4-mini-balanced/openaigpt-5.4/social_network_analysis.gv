digraph social_network_analysis {
  graph [
    rankdir="TB",
    bgcolor="transparent",
    margin="0.03",
    pad="0.02",
    nodesep="0.22",
    ranksep="0.32",
    splines="polyline",
    concentrate="true",
    outputorder="edgesfirst",
    ordering="out"
  ];
  node [
    shape="box",
    style="rounded,filled",
    fontname="Helvetica-Bold",
    fontsize="9",
    margin="0.045,0.035",
    penwidth="0.8",
    color="#666666"
  ];
  edge [
    fontname="Helvetica-Bold",
    fontsize="6.8",
    arrowsize="0.55",
    fontcolor="#333333"
  ];

  "START" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>START</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,8 std=1,4</B></FONT></TD></TR></TABLE>>, fillcolor="#bedcb4"];
  "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>COMPLETE</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=57</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,7 std=1,8</B></FONT></TD></TR></TABLE>>, fillcolor="#d6e3ba"];
  "process_modeler" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>process<BR/>modeler</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=22</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,2 std=2,0</B></FONT></TD></TR></TABLE>>, fillcolor="#e2e6be"];
  "event_log_interpreter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>event<BR/>log<BR/>interpreter</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=13</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,7 std=1,6</B></FONT></TD></TR></TABLE>>, fillcolor="#d6e3ba"];
  "conformance_anomaly_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>conformance<BR/>anomaly<BR/>checker</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=12</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,2 std=1,2</B></FONT></TD></TR></TABLE>>, fillcolor="#cce0b8"];
  "optimization_consultant" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>optimization<BR/>consultant</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=10</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=6,8 std=1,7</B></FONT></TD></TR></TABLE>>, fillcolor="#d6e3ba"];
  "query_and_sql_analyst" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>query<BR/>and<BR/>sql<BR/>analyst</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,3 std=1,3</B></FONT></TD></TR></TABLE>>, fillcolor="#cadfb8"];
  "fairness_and_ethics_reviewer" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>fairness<BR/>and<BR/>ethics<BR/>reviewer</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,1 std=1,3</B></FONT></TD></TR></TABLE>>, fillcolor="#cee0b8"];
  "hypothesis_generator" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>hypothesis<BR/>generator</B></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>f=6</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="7"><B>mu=7,8 std=0,8</B></FONT></TD></TR></TABLE>>, fillcolor="#bedbb4"];

  "START" -> "process_modeler" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=18</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,3 std=2,0</B></FONT></TD></TR></TABLE>>, color="#c4ce7c", fontcolor="#c4ce7c", penwidth="4.50"];
  "process_modeler" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=15</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,9 std=2,2</B></FONT></TD></TR></TABLE>>, color="#d6d381", fontcolor="#d6d381", penwidth="3.90"];
  "START" -> "event_log_interpreter" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=13</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,7 std=1,6</B></FONT></TD></TR></TABLE>>, color="#aec776", fontcolor="#aec776", penwidth="3.50"];
  "conformance_anomaly_checker" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=9</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,4 std=1,2</B></FONT></TD></TR></TABLE>>, color="#92be6f", fontcolor="#92be6f", penwidth="2.70"];
  "event_log_interpreter" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=9</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,2 std=1,9</B></FONT></TD></TR></TABLE>>, color="#c6ce7c", fontcolor="#c6ce7c", penwidth="2.70"];
  "START" -> "conformance_anomaly_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,9 std=0,9</B></FONT></TD></TR></TABLE>>, color="#79b669", fontcolor="#79b669", penwidth="2.30"];
  "optimization_consultant" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=7</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,9 std=0,6</B></FONT></TD></TR></TABLE>>, color="#7cb769", fontcolor="#7cb769", penwidth="2.30"];
  "query_and_sql_analyst" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=6</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,5 std=0,9</B></FONT></TD></TR></TABLE>>, color="#8ebd6e", fontcolor="#8ebd6e", penwidth="2.10"];
  "START" -> "fairness_and_ethics_reviewer" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=6</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,3 std=1,3</B></FONT></TD></TR></TABLE>>, color="#94bf70", fontcolor="#94bf70", penwidth="2.10"];
  "fairness_and_ethics_reviewer" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=6</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,7 std=1,7</B></FONT></TD></TR></TABLE>>, color="#b0c877", fontcolor="#b0c877", penwidth="2.10"];
  "START" -> "optimization_consultant" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=4</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,1 std=0,1</B></FONT></TD></TR></TABLE>>, color="#73b467", fontcolor="#73b467", penwidth="1.70"];
  "START" -> "hypothesis_generator" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=4</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,0 std=0,9</B></FONT></TD></TR></TABLE>>, color="#74b467", fontcolor="#74b467", penwidth="1.70"];
  "hypothesis_generator" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=8,1 std=0,2</B></FONT></TD></TR></TABLE>>, color="#6fb366", fontcolor="#6fb366", penwidth="1.50"];
  "START" -> "query_and_sql_analyst" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,8 std=1,2</B></FONT></TD></TR></TABLE>>, color="#7db76a", fontcolor="#7db76a", penwidth="1.50"];
  "process_modeler" -> "conformance_anomaly_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,8 std=0,5</B></FONT></TD></TR></TABLE>>, color="#aac675", fontcolor="#aac675", penwidth="1.50"];
  "event_log_interpreter" -> "optimization_consultant" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=3</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,7 std=0,2</B></FONT></TD></TR></TABLE>>, color="#b0c877", fontcolor="#b0c877", penwidth="1.50"];
  "optimization_consultant" -> "process_modeler" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,8 std=0,2</B></FONT></TD></TR></TABLE>>, color="#7eb86a", fontcolor="#7eb86a", penwidth="1.30"];
  "hypothesis_generator" -> "query_and_sql_analyst" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,5 std=0,3</B></FONT></TD></TR></TABLE>>, color="#8cbc6e", fontcolor="#8cbc6e", penwidth="1.30"];
  "conformance_anomaly_checker" -> "query_and_sql_analyst" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,3 std=1,6</B></FONT></TD></TR></TABLE>>, color="#c0cd7b", fontcolor="#c0cd7b", penwidth="1.30"];
  "process_modeler" -> "optimization_consultant" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,1 std=2,7</B></FONT></TD></TR></TABLE>>, color="#f9df8a", fontcolor="#f9df8a", penwidth="1.30"];
  "START" -> "COMPLETE" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=2</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=4,8 std=0,1</B></FONT></TD></TR></TABLE>>, color="#fddb88", fontcolor="#fddb88", penwidth="1.30"];
  "conformance_anomaly_checker" -> "hypothesis_generator" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,4 std=0,0</B></FONT></TD></TR></TABLE>>, color="#91bd6f", fontcolor="#91bd6f", penwidth="1.10"];
  "query_and_sql_analyst" -> "hypothesis_generator" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=7,4 std=0,0</B></FONT></TD></TR></TABLE>>, color="#91bd6f", fontcolor="#91bd6f", penwidth="1.10"];
  "process_modeler" -> "fairness_and_ethics_reviewer" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=6,1 std=0,0</B></FONT></TD></TR></TABLE>>, color="#ccd07e", fontcolor="#ccd07e", penwidth="1.10"];
  "event_log_interpreter" -> "process_modeler" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,8 std=0,0</B></FONT></TD></TR></TABLE>>, color="#dad482", fontcolor="#dad482", penwidth="1.10"];
  "fairness_and_ethics_reviewer" -> "conformance_anomaly_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,4 std=0,0</B></FONT></TD></TR></TABLE>>, color="#ecda86", fontcolor="#ecda86", penwidth="1.10"];
  "optimization_consultant" -> "conformance_anomaly_checker" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,3 std=0,0</B></FONT></TD></TR></TABLE>>, color="#f0dc87", fontcolor="#f0dc87", penwidth="1.10"];
  "hypothesis_generator" -> "optimization_consultant" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=5,2 std=0,0</B></FONT></TD></TR></TABLE>>, color="#f5dd89", fontcolor="#f5dd89", penwidth="1.10"];
  "process_modeler" -> "process_modeler" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD><FONT POINT-SIZE="6.8"><B>f=1</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="6.8"><B>mu=3,1 std=0,0</B></FONT></TD></TR></TABLE>>, color="#ef9d65", fontcolor="#ef9d65", penwidth="1.10"];
